7 7.81L57.27 8.00L58.61 7.48L60.11 6.51L61.70 5.48L63.26 4.83L64.67 4.85L65.82 5.66L66.70 7.11L67.38 8.87L68.02 10.54L68.81 11.75L69.89 12.30L71.33 12.23L73.06 11.77L74.88 11.28L76.58 11.14L77.91 11.59L78.75 12.72L79.14 14.37L79.24 16.26L79.33 18.04L79.71 19.43L80.57 20.29L81.96 20.67L83.74 20.76L85.63 20.86L87.28 21.25L88.41 22.09L88.86 23.42L88.72 25.12L88.23 26.94L87.77 28.67L87.70 30.11L88.25 31.19L89.46 31.98L91.13 32.62L92.89 33.30L94.34 34.18L95.15 35.33L95.17 36.74L94.52 38.30L93.49 39.89L92.52 41.39L92.00 42.73L92.19 43.93L93.10 45.06L94.48 46.18L95.95 47.37L97.06 48.66L97.47 50.00Z";
---

<BaseLayout
  title="Da Vinci Café — Panadería artesanal y cafetería en Maracaibo"
  description="Da Vinci Café Maracaibo — Panadería artesanal, repostería y cafetería. Panes de masa madre, postres únicos y desayunos excepcionales en 4 sedes."
  canonical="https://davinciristorante.com.ve/cafe.html"
  hreflangs={[
    { hreflang: "es", href: "https://davinciristorante.com.ve/cafe.html" },
    { hreflang: "en", href: "https://davinciristorante.com.ve/cafe.html" },
    { hreflang: "it", href: "https://davinciristorante.com.ve/cafe.html" },
    { hreflang: "x-default", href: "https://davinciristorante.com.ve/cafe.html" },
  ]}
  alternatePage={{ href: "https://davinciristorante.com.ve/", title: "Da Vinci Ristorante" }}
  ogImage="https://davinciristorante.com.ve/img/cafe/hero/Davinci%20cafe%20hero%201.webp"
  siteName="Da Vinci Café · Grupo Da Vinci"
  bodyClass="dv-app dv-app--cafe"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/cafe/hero/Davinci cafe hero 2.webp" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Nav
    variant="cafe"
    logoLabel="Da Vinci Café"
    links={navLinks}
    cta={{ href: "https://www.instagram.com/davincicafe.ve/", i18nKey: "cafe.cta2", label: "Síguenos" }}
  >
    <LangSwitcher slot="lang" />
    <LangSwitcher slot="lang-mobile" mobile />
  </Nav>

  <!-- ===== HERO ===== -->
  <header class="dv-chero" id="inicio">
    <div class="dv-hero__slides">
      {
        heroSlides.map((slide) => (
          <div
            class={["dv-hero__slide", slide.extraClass].filter(Boolean).join(" ")}
            style={`background-image: url("/img/cafe/hero/${slide.file}");`}
          />
        ))
      }
    </div>
    <div class="dv-chero__inner">
      <span class="dv-chero__kicker" data-i18n="cafe.hero.kicker"
        >Panadería artesanal · Repostería · Cafetería · Maracaibo</span
      >
      <h1 class="dv-chero__title" data-i18n="cafe.hero.title">Hecho con amor,<br />horneado con legado</h1>
      <p class="dv-chero__sub" data-i18n="cafe.hero.sub">
        Pan recién horneado, postres únicos y café recién hecho. Cuatro sedes
        en Maracaibo para que te quedes un poco más.
      </p>
      <div class="dv-chero__actions">
        <a class="btn btn--cafe" href="#menu" data-cafe-menu-open data-i18n="cafe.hero.cta1">Ver la carta</a>
        <a class="btn btn--cafe-ghost" href="#visita" data-i18n="cafe.hero.cta2">Ubícanos</a>
      </div>
    </div>
    <SocialRail class="dv-csocial" links={heroSocialLinks} />
    <div class="dv-hero__dots">
      <button class="is-active" aria-label="Slide 1"></button>
      <button aria-label="Slide 2"></button>
      <button aria-label="Slide 3"></button>
      <button aria-label="Slide 4"></button>
      <button aria-label="Slide 5"></button>
    </div>
  </header>

  <!-- ===== ESENCIA / ABOUT ===== -->
  <section class="sec dv-cabout" id="esencia">
    <div class="wrap dv-cabout__grid">
      <div class="dv-cabout__media reveal">
        <div class="dv-cabout__art">
          <span class="dv-shape dv-cabout__s dv-cabout__s--scallop" style="width: 168px; height: 168px" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="100%" height="100%"><path d={SCALLOP_PATH} fill="#a3bd78" /></svg>
          </span>
          <span class="dv-shape dv-cabout__s dv-cabout__s--circle" style="width: 94px; height: 94px" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="100%" height="100%"><circle cx="50" cy="50" r="48" fill="#8073AE" /></svg>
          </span>
          <div class="dv-cabout__photo">
            <img src="/img/cafe/Seccion Cafe.webp" width="900" height="900" alt="Da Vinci Café" loading="lazy" />
          </div>
          <span class="dv-shape dv-cabout__s dv-cabout__s--seal" style="width: 108px; height: 108px" aria-hidden="true">
            <svg viewBox="0 0 100 100" width="100%" height="100%"><path d={SEAL_PATH} fill="#4d3f24" /></svg>
            <span class="dv-shape__in">
              <span class="dv-cabout__sealtxt">Café<small>Grupo Da Vinci</small></span>
            </span>
          </span>
        </div>
      </div>
      <div class="reveal">
        <span class="kicker" data-i18n="cafe.kicker">Grupo Da Vinci</span>
        <h2 class="h-display" data-i18n="cafe.about.tagline">Una pasión artesanal con raíces de verdad</h2>
        <p class="dv-lead" data-i18n="cafe.about.body">
          Nacimos del deseo de hacer las cosas bien, sin atajos ni prisas. Cada
          pan que sale del horno y cada postre que preparamos lleva el respeto
          por el oficio y el amor por el detalle que marca la diferencia.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== FILOSOFÍA ===== -->
  <div class="dv-cafe__phil">
    <div class="sec">
      <div class="dv-cafe__phil-head reveal">
        <span class="kicker" data-i18n="cafe.phil.kicker">Nuestra esencia</span>
        <h2 class="h-display" data-i18n="cafe.phil.title">Nuestra filosofía</h2>
      </div>
      <div class="dv-cafe__phil-grid">
        <div class="dv-cafe__phil-col reveal">
          <h3 data-i18n="cafe.mision.heading">Misión</h3>
          <p data-i18n="cafe.mision.body">
            Ofrecer productos frescos, deliciosos y de alta calidad en cada
            visita, combinando tradición y calidad en el arte de la
            panadería, cafetería y repostería. Crear un ambiente acogedor
            donde cada cliente se sienta como en casa.
          </p>
        </div>
        <div class="dv-cafe__phil-col reveal">
          <h3 data-i18n="cafe.vision.heading">Visión</h3>
          <p data-i18n="cafe.vision.body">
            Ser la referencia líder en la región para disfrutar de panes
            artesanales, postres únicos y desayunos excepcionales, con una
            experiencia cálida que inspire momentos de felicidad y conexión.
          </p>
        </div>
        <div class="dv-cafe__phil-col reveal">
          <h3 data-i18n="cafe.valores.heading">Valores</h3>
          <p data-i18n="cafe.valores.body">Excelencia · Servicio sobresaliente · Respeto · Compromiso</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== CARTA ===== -->
  <section class="sec dv-cafe__bake" id="carta">
    <div class="dv-bakes-head reveal">
      <span class="kicker" data-i18n="cafe.menu.kicker">Nuestra carta</span>
      <h2 class="h-display" data-i18n="cafe.menu.title">Lo que preparamos</h2>
    </div>
    <div class="dv-bakes">
      {
        BAKE_CATEGORIES.map((bake) => (
          <button class="dv-bake reveal" type="button" data-cafe-menu-cat={bake.cat}>
            <h4 data-i18n={bake.titleI18n}>{bake.title}</h4>
            <p data-i18n={bake.descI18n}>{bake.desc}</p>
          </button>
        ))
      }
    </div>
    <div class="dv-bakes-cta reveal">
      <button class="dv-bakes-cta__btn" type="button" data-cafe-menu-open>Ver menú completo</button>
    </div>
  </section>

  <!-- ===== GALERÍA / NUESTRO ESPACIO ===== -->
  <section class="dv-cgal" id="espacio">
    <span class="dv-shape dv-cgal__deco" style="width: 220px; height: 220px" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="100%" height="100%"><path d={SCALLOP_PATH} fill="#ece2cd" /></svg>
    </span>
    <div class="dv-cgal__head reveal">
      <span class="kicker" data-i18n="cafe.gallery.kicker">Nuestro espacio</span>
      <h2 class="h-display" data-i18n="cafe.gallery.title">Momentos que saben a casa</h2>
    </div>
    <div class="marquee" aria-label="Galería Da Vinci Café">
      <div class="marquee__row">
        {
          GALLERY_FILES.map((n) => (
            <button class="tile" type="button" aria-label="Ambiente de Da Vinci Café">
              <img src={`/img/cafe/Davinci cafe carousel ${n}.webp`} width="340" height="500" alt="" loading="lazy" />
            </button>
          ))
        }
        {
          GALLERY_FILES.map((n) => (
            <button class="tile" type="button" aria-hidden="true" tabindex="-1">
              <img src={`/img/cafe/Davinci cafe carousel ${n}.webp`} width="340" height="500" alt="" loading="lazy" />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="lightbox" data-open="false">
    <button class="lightbox__close" aria-label="Cerrar">×</button>
    <img class="lightbox__img" alt="" />
  </div>

  <VisitSection
    id="visita"
    variant="cafe"
    kickerI18n="cafe.h.kicker"
    kickerText="Ubícanos"
    titleI18n="cafe.h.title"
    titleText="Horario"
    hours={[
      { labelI18n: "cafe.h.d1", labelText: "Todos los días", valueI18n: "cafe.h.t1", valueText: "07:00 a. m. – 10:00 p. m." },
    ]}
    mapTitle="Mapa Da Vinci Café"
    mapSrc="https://www.google.com/maps/d/embed?mid=1J54zMKdY-m6NaBEE37M44GPNfvaR7fM&ehbc=2E312F&noprof=1"
    headingI18n="cafe.u.title"
    headingText="Maracaibo, Edo. Zulia"
    subI18n="cafe.u.sub"
    subText="Cuatro sedes para encontrarnos. Te esperamos."
    subColor="#6a5e4c"
    sedes={[
      {
        href: "https://www.google.com/maps/search/?api=1&query=Farmacia+Maraplus+Bella+Vista+Maracaibo+Venezuela",
        name: "Da Vinci Café",
        suffix: "Bella Vista",
        address: "Av. 4 Bella Vista con calle 74, dentro de Farmacia Maraplus",
      },
      {
        href: "https://maps.app.goo.gl/J3nRag9HEqZHiGjD9",
        name: "Da Vinci Café",
        suffix: "Norte",
        address: "Calle 43, Av. 15, Urb. Rosal Sur, sector Fuerzas Armadas",
      },
      {
        href: "https://maps.app.goo.gl/ef2HBMzeqhaH4UU29",
        name: "Da Vinci Café",
        suffix: "Cumbres",
        address: "Dentro de Farmacia Maraplus, Cumbres de Maracaibo",
      },
      {
        href: "https://maps.app.goo.gl/N6JBmWDNcqHzPVQZ9",
        name: "Da Vinci Café",
        suffix: "Indio Mara",
        address: "Dentro de Farmacia Maraplus, Indio Mara",
      },
    ]}
  />

  <Footer
    variant="cafe"
    logoLabel="Da Vinci Café"
    columns={[
      {
        heading: { i18nKey: "cafe.menu.kicker", label: "Nuestra carta" },
        links: [
          { href: "#carta", i18nKey: "cafe.menu.title", label: "Lo que horneamos" },
          { href: "#esencia", i18nKey: "nav.nosotros", label: "Nosotros" },
        ],
      },
      {
