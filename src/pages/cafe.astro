import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import SocialRail from "../components/SocialRail.astro";
import Footer from "../components/Footer.astro";
import VisitSection from "../components/VisitSection.astro";
import Icon from "../components/Icon.astro";
import structuredData from "../data/cafe-structured-data.json";
import "../styles/cafe.css";
import "../styles/components/cafe.css";
import "../styles/components/menu-modal.css";

const navLinks = [
  { href: "#carta", i18nKey: "cafe.menu.kicker", label: "Nuestra carta" },
  { href: "#menu", label: "Menú", dataAttr: "data-cafe-menu-open" },
  { href: "index.html", i18nKey: "nav.restaurante", label: "Restaurante", class: "dv-nav__link--rist" },
  { href: "#espacio", i18nKey: "cafe.gallery.kicker", label: "Nuestro espacio" },
  { href: "#visita", i18nKey: "cafe.h.kicker", label: "Ubícanos" },
];

const heroSlides = [
  { file: "Davinci cafe hero 2.webp", extraClass: "dv-hero__slide--right is-active" },
  { file: "Davinci cafe hero 1.webp" },
  { file: "Davinci cafe hero 3.webp" },
  { file: "Davinci cafe hero 5.webp", extraClass: "dv-hero__slide--right" },
  { file: "Davinci cafe hero 4.webp" },
];

const heroSocialLinks = [
  { icon: "instagram" as const, href: "https://www.instagram.com/davincicafe.ve/", label: "Instagram" },
  { icon: "tiktok" as const, href: "https://www.tiktok.com/@grupodavinci", label: "TikTok" },
];

const footerSocialLinks = [
  { icon: "instagram" as const, href: "https://www.instagram.com/davincicafe.ve/", label: "Instagram" },
  { icon: "tiktok" as const, href: "https://www.tiktok.com/@grupodavinci", label: "TikTok" },
];

const BAKE_CATEGORIES = [
  { cat: "Panes artesanales", titleI18n: "cafe.m1", title: "Panes artesanales", descI18n: "cafe.m1d", desc: "Masa madre, horneado del día." },
  { cat: "Desayunos", titleI18n: "cafe.m2", title: "Desayunos", descI18n: "cafe.m2d", desc: "Para empezar el día como se debe." },
  { cat: "Repostería", titleI18n: "cafe.m3", title: "Repostería", descI18n: "cafe.m3d", desc: "Postres únicos, dulces de la casa." },
  { cat: "Bebidas", titleI18n: "cafe.m4", title: "Bebidas", descI18n: "cafe.m4d", desc: "Infusiones, jugos y bebidas frías." },
  { cat: "Variedad de cafés", titleI18n: "cafe.m5", title: "Variedad de cafés", descI18n: "cafe.m5d", desc: "Espresso, latte art y café recién hecho." },
