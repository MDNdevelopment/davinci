---
interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
---

<div
  class="dv-lang"
  role="group"
  aria-label="Idioma"
  style={mobile ? "align-self: flex-start; margin-top: 1rem" : undefined}
>
  <button class="is-active" data-lang="es">ES</button>
  <button data-lang="en">EN</button>
  <button data-lang="it">IT</button>
</div>
